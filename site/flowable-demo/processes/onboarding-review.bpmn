<?xml version="1.0" encoding="UTF-8"?>
<!-- Ties the onboarding models together, so the demo graph has a process that reaches a case, a
     decision, an agent, a service and a Java delegate. -->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/demo"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">
  <process id="onboardingReviewProcess" name="Onboarding Review"
           flowable:candidateStarterGroups="sales,compliance">
    <documentation>Reviews an onboarding application and scores its risk.</documentation>

    <startEvent id="start" flowable:formKey="onboardingForm"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="enrich"/>

    <serviceTask id="enrich" name="Enrich application"
                 flowable:delegateExpression="${orderDelegate}">
      <extensionElements>
        <flowable:executionListener event="end" flowable:delegateExpression="${auditListener}"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f2" sourceRef="enrich" targetRef="lookupOrder"/>

    <serviceTask id="lookupOrder" name="Look up order" flowable:type="service-registry">
      <extensionElements>
        <flowable:field name="serviceKey"><flowable:string>orderService</flowable:string></flowable:field>
        <flowable:field name="operationKey"><flowable:string>findByNumber</flowable:string></flowable:field>
        <flowable:in source="orderNumber" target="orderNumber"/>
        <flowable:out source="companyName" target="companyName"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f3" sourceRef="lookupOrder" targetRef="scoreRisk"/>

    <serviceTask id="scoreRisk" name="Score risk" flowable:type="dmn">
      <extensionElements>
        <flowable:field name="decisionTableReferenceKey">
          <flowable:string>dec_risk</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f4" sourceRef="scoreRisk" targetRef="askAssistant"/>

    <serviceTask id="askAssistant" name="Ask the assistant" flowable:type="agent">
      <extensionElements>
        <flowable:field name="agentModelKey"><flowable:string>supportAgent</flowable:string></flowable:field>
        <flowable:in source="companyName" target="question"/>
        <flowable:out source="answer" target="assistantAnswer"/>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f5" sourceRef="askAssistant" targetRef="reviewCase"/>

    <caseTask id="reviewCase" name="Manual review" flowable:caseRef="DEMO-reviewCase">
      <extensionElements>
        <flowable:in source="companyName" target="companyName"/>
        <!-- Never read on the other side: one honest `unreadInputs` row for the demo. -->
        <flowable:in source="expectedVolume" target="applicationVolume"/>
      </extensionElements>
    </caseTask>
    <sequenceFlow id="f6" sourceRef="reviewCase" targetRef="decide"/>

    <userTask id="decide" name="Final decision"
              flowable:candidateGroups="compliance" flowable:formKey="onboardingForm">
      <documentation>Compliance signs off, or rejects with a reason.</documentation>
    </userTask>
    <sequenceFlow id="f7" sourceRef="decide" targetRef="stamp"/>

    <scriptTask id="stamp" name="Record the decision" scriptFormat="groovy">
      <documentation>Builds an audit note. `retryCount` is named only here — Atlas says so rather
        than pretending to know where it comes from.</documentation>
      <script>
        def note = "reviewed:" + companyName + ":" + retryCount
        execution.setVariable('auditNote', note)
      </script>
    </scriptTask>
    <sequenceFlow id="f8" sourceRef="stamp" targetRef="end">
      <conditionExpression xsi:type="tFormalExpression"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${myfns:isComplete(auditNote)}</conditionExpression>
    </sequenceFlow>
    <endEvent id="end"/>
  </process>

  <!-- Layout. The row break after `askAssistant` keeps the eight steps readable at one zoom level;
       the glyphs come from each task's `flowable:type`, not from anything written here. -->
  <bpmndi:BPMNDiagram id="dia_onboardingReviewProcess">
    <bpmndi:BPMNPlane id="plane_onboardingReviewProcess" bpmnElement="onboardingReviewProcess">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="115" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_enrich" bpmnElement="enrich">
        <omgdc:Bounds x="180" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_lookupOrder" bpmnElement="lookupOrder">
        <omgdc:Bounds x="340" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_scoreRisk" bpmnElement="scoreRisk">
        <omgdc:Bounds x="500" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_askAssistant" bpmnElement="askAssistant">
        <omgdc:Bounds x="660" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_reviewCase" bpmnElement="reviewCase">
        <omgdc:Bounds x="100" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_decide" bpmnElement="decide">
        <omgdc:Bounds x="260" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_stamp" bpmnElement="stamp">
        <omgdc:Bounds x="420" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end" bpmnElement="end">
        <omgdc:Bounds x="580" y="255" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1">
        <omgdi:waypoint x="130" y="130"/>
        <omgdi:waypoint x="180" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2">
        <omgdi:waypoint x="280" y="130"/>
        <omgdi:waypoint x="340" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3">
        <omgdi:waypoint x="440" y="130"/>
        <omgdi:waypoint x="500" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4">
        <omgdi:waypoint x="600" y="130"/>
        <omgdi:waypoint x="660" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5">
        <omgdi:waypoint x="710" y="160"/>
        <omgdi:waypoint x="710" y="200"/>
        <omgdi:waypoint x="150" y="200"/>
        <omgdi:waypoint x="150" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6">
        <omgdi:waypoint x="200" y="270"/>
        <omgdi:waypoint x="260" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7">
        <omgdi:waypoint x="360" y="270"/>
        <omgdi:waypoint x="420" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f8" bpmnElement="f8">
        <omgdi:waypoint x="520" y="270"/>
        <omgdi:waypoint x="580" y="270"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
