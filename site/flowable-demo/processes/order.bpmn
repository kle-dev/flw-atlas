<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="http://flowable.org/test"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">
  <process id="orderProcess" name="Order Process" flowable:candidateStarterGroups="sales">
    <documentation>Handles an order from entry to approval.</documentation>
    <startEvent id="start" flowable:formKey="orderForm"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="calcTask"/>
    <serviceTask id="calcTask" name="Calculate total"
                 flowable:expression="${demoBean.run(execution)}"
                 flowable:resultVariableName="total"/>
    <sequenceFlow id="f2" sourceRef="calcTask" targetRef="approveTask">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${total &gt; 100}</conditionExpression>
    </sequenceFlow>
    <userTask id="approveTask" name="Approve order"
              flowable:candidateGroups="backoffice" flowable:formKey="orderForm">
      <documentation>Backoffice checks the order total before it ships.</documentation>
    </userTask>
    <sequenceFlow id="f3" sourceRef="approveTask" targetRef="notifyTask">
      <conditionExpression xsi:type="tFormalExpression" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">${vars:bogus(}</conditionExpression>
    </sequenceFlow>
    <serviceTask id="notifyTask" name="Notify"
                 flowable:delegateExpression="${notifierBean}">
      <extensionElements>
        <flowable:executionListener event="end">
          <flowable:script scriptFormat="groovy">execution.setVariable('notified', true)</flowable:script>
        </flowable:executionListener>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f4" sourceRef="notifyTask" targetRef="callSub"/>
    <callActivity id="callSub" name="Fulfil" calledElement="fulfilmentProcess">
      <extensionElements>
        <!-- `subOrderId` is a name the callee never mentions at all: nothing anywhere reads it.
             `orderId` is passed through under its own name and read here but not there — the two halves
             of the unused-variable report, one mapping each. -->
        <flowable:in source="orderId" target="subOrderId"/>
        <flowable:in source="orderId" target="orderId"/>
        <flowable:out source="subTotal" target="total"/>
      </extensionElements>
    </callActivity>
    <sequenceFlow id="f5" sourceRef="callSub" targetRef="decideTask"/>
    <serviceTask id="decideTask" name="Decide approval" flowable:type="dmn">
      <extensionElements>
        <flowable:field name="decisionTableReferenceKey">
          <flowable:string>orderDecision</flowable:string>
        </flowable:field>
      </extensionElements>
    </serviceTask>
    <sequenceFlow id="f6" sourceRef="decideTask" targetRef="waitShipped"/>
    <receiveTask id="waitShipped" name="Wait for shipment">
      <extensionElements>
        <flowable:eventType>orderShipped</flowable:eventType>
      </extensionElements>
    </receiveTask>
    <sequenceFlow id="f7" sourceRef="waitShipped" targetRef="stampTask"/>
    <scriptTask id="stampTask" name="Stamp order" scriptFormat="groovy">
      <documentation>Builds the shipping stamp from the order and the courier.</documentation>
      <script>
        def stamp = "shipped-" + orderId + "-" + courierCode
        execution.setVariable('shippingStamp', stamp)
      </script>
    </scriptTask>
    <sequenceFlow id="f8" sourceRef="stampTask" targetRef="end"/>
    <!-- deliberately broken (like the ${vars:bogus(} expression above): the unclosed '(' feeds the
         script-syntax check through every artifact — graph problems, overview marker, Checks tab -->
    <scriptTask id="badStamp" name="Broken stamp" scriptFormat="groovy">
      <script>execution.setVariable('shippingStamp', "x-" + orderId</script>
    </scriptTask>
    <!-- deliberately misspelled API member: pins the semantic (bindings-catalog) check end to end -->
    <scriptTask id="badApi" name="Broken API call" scriptFormat="groovy">
      <script>execution.setTransientVariabel('meta', orderId)</script>
    </scriptTask>
    <endEvent id="end"/>
  </process>

  <!-- Layout, so the explorer and the plugin can draw this process. Two rows: the happy path wraps
       after `callSub`; the two deliberately-broken script tasks sit unattached below it, which is
       exactly what they are in the model. -->
  <bpmndi:BPMNDiagram id="dia_orderProcess">
    <bpmndi:BPMNPlane id="plane_orderProcess" bpmnElement="orderProcess">
      <bpmndi:BPMNShape id="s_start" bpmnElement="start">
        <omgdc:Bounds x="100" y="115" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_calcTask" bpmnElement="calcTask">
        <omgdc:Bounds x="180" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_approveTask" bpmnElement="approveTask">
        <omgdc:Bounds x="340" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_notifyTask" bpmnElement="notifyTask">
        <omgdc:Bounds x="500" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_callSub" bpmnElement="callSub">
        <omgdc:Bounds x="660" y="100" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_decideTask" bpmnElement="decideTask">
        <omgdc:Bounds x="100" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_waitShipped" bpmnElement="waitShipped">
        <omgdc:Bounds x="260" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_stampTask" bpmnElement="stampTask">
        <omgdc:Bounds x="420" y="240" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_end" bpmnElement="end">
        <omgdc:Bounds x="580" y="255" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_badStamp" bpmnElement="badStamp">
        <omgdc:Bounds x="100" y="360" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_badApi" bpmnElement="badApi">
        <omgdc:Bounds x="260" y="360" width="100" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="e_f1" bpmnElement="f1">
        <omgdi:waypoint x="130" y="130"/>
        <omgdi:waypoint x="180" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f2" bpmnElement="f2">
        <omgdi:waypoint x="280" y="130"/>
        <omgdi:waypoint x="340" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f3" bpmnElement="f3">
        <omgdi:waypoint x="440" y="130"/>
        <omgdi:waypoint x="500" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f4" bpmnElement="f4">
        <omgdi:waypoint x="600" y="130"/>
        <omgdi:waypoint x="660" y="130"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f5" bpmnElement="f5">
        <omgdi:waypoint x="710" y="160"/>
        <omgdi:waypoint x="710" y="200"/>
        <omgdi:waypoint x="150" y="200"/>
        <omgdi:waypoint x="150" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f6" bpmnElement="f6">
        <omgdi:waypoint x="200" y="270"/>
        <omgdi:waypoint x="260" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f7" bpmnElement="f7">
        <omgdi:waypoint x="360" y="270"/>
        <omgdi:waypoint x="420" y="270"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="e_f8" bpmnElement="f8">
        <omgdi:waypoint x="520" y="270"/>
        <omgdi:waypoint x="580" y="270"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>
