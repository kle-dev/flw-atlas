<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/CMMN/20151109/MODEL"
             xmlns:cmmndi="http://www.omg.org/spec/CMMN/20151109/CMMNDI"
             xmlns:dc="http://www.omg.org/spec/CMMN/20151109/DC"
             xmlns:di="http://www.omg.org/spec/CMMN/20151109/DI"
             targetNamespace="http://flowable.org/demo">
  <case id="DEMO-reviewCase" name="Review Case">
    <casePlanModel id="cpm" name="Review">
      <planItem id="pi_task" definitionRef="ht_review">
        <entryCriterion id="crit_entry" sentryRef="sentry_ready"/>
      </planItem>
      <planItem id="pi_ms" definitionRef="ms_done">
        <!-- The reason the case has a connecting line at all: a condition-only sentry states no
             dependency, so there is nothing to draw. An onPart does. -->
        <entryCriterion id="crit_ms" sentryRef="sentry_reviewed"/>
        <exitCriterion id="crit_exit" sentryRef="sentry_closed"/>
      </planItem>
      <sentry id="sentry_ready">
        <ifPart><condition><![CDATA[${documentsComplete}]]></condition></ifPart>
      </sentry>
      <sentry id="sentry_reviewed">
        <planItemOnPart id="onpart_reviewed" sourceRef="pi_task">
          <standardEvent>complete</standardEvent>
        </planItemOnPart>
      </sentry>
      <sentry id="sentry_closed">
        <ifPart><condition><![CDATA[${reviewOutcome == 'closed'}]]></condition></ifPart>
      </sentry>
      <humanTask id="ht_review" name="Review"/>
      <milestone id="ms_done" name="Completed"/>
    </casePlanModel>
  </case>
  <cmmndi:CMMNDI>
    <cmmndi:CMMNDiagram>
      <cmmndi:CMMNShape cmmnElementRef="cpm">
        <dc:Bounds x="40" y="40" width="400" height="180"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape cmmnElementRef="pi_task">
        <dc:Bounds x="80" y="120" width="100" height="60"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape cmmnElementRef="pi_ms">
        <dc:Bounds x="240" y="130" width="120" height="40"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape cmmnElementRef="crit_entry">
        <dc:Bounds x="73" y="140" width="14" height="22"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape cmmnElementRef="crit_ms">
        <dc:Bounds x="233" y="139" width="14" height="22"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNShape cmmnElementRef="crit_exit">
        <dc:Bounds x="353" y="139" width="14" height="22"/>
      </cmmndi:CMMNShape>
      <cmmndi:CMMNEdge cmmnElementRef="onpart_reviewed">
        <di:waypoint x="180" y="150"/>
        <di:waypoint x="233" y="150"/>
      </cmmndi:CMMNEdge>
    </cmmndi:CMMNDiagram>
  </cmmndi:CMMNDI>
</definitions>
