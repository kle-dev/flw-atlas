# Generated analysis artifacts (per-project output — never commit, may contain client data)
atlas-output/
*.explorer.html
*.summary.md
*.overview.md
*.graph.json
*.flow.json
APP_OVERVIEW.*
APP_SUMMARY.*
APP_EXPLORER.*
*.CLAUDE.md
/CLAUDE.md

# Screenshots / images
screenshots/
*.png
*.jpg
*.jpeg
*.gif

# Email/distribution bundles (regenerable)
email/

# Gradle / Kotlin / IntelliJ-Platform build output (all modules: core, cli, idea-plugin)
.gradle/
build/
out/
bin/
*.iml
.intellijPlatform/
.kotlin/

# Editor / OS
.idea/
.vscode/
# .claude/ holds a mix of session-local state (settings.local.json, scheduled_tasks.lock, …) and
# team-shared slash commands under .claude/commands/. Ignore everything by default, un-ignore
# commands/ so the /narrate skill and its siblings travel with the repo.
.claude/*
!.claude/commands/
.gitattributes
.DS_Store

# Exception: committed Marketplace media for the IntelliJ plugin (intentional content)
!idea-plugin/marketplace-assets/*.png
!idea-plugin/marketplace-assets/*.gif

# Exception: golden test references (deliberately committed regression baselines)
!core/src/test/resources/golden/*.summary.md
!core/src/test/resources/golden/*.overview.md
!core/src/test/resources/golden/*.graph.json
!core/src/test/resources/golden/*.flow.json
