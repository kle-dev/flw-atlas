<!-- require-restart: the plugin registers languages / file types / parser definitions (the two
     expression dialects) which cannot be loaded dynamically, so force IntelliJ to prompt for a
     restart on install / update / uninstall instead of silently half-loading. -->
<idea-plugin require-restart="true">
    <id>com.flowable.atlas</id>
    <name>Flowable Atlas</name>
    <!-- No <version> here on purpose: patchPluginXml injects the Gradle project version at build
         time (root build.gradle.kts → allprojects { version }). A literal here is dead text that
         drifts — this one had been reading 0.10.4 since three releases ago. -->
    <vendor email="kevin.klever@flowable.com" url="https://www.flowable.com">Flowable</vendor>

    <description><![CDATA[
        <p><b>The complete Flowable companion for IntelliJ IDEA.</b> Flowable Atlas turns the model keys
        and expressions scattered across your Java code and Flowable models into first-class, IDE-aware
        references — completed, validated and navigable — and maps your whole project into a single
        interactive explorer. Everything is resolved against the models that <i>actually live in your
        repository</i>, so a wrong key or a broken expression is caught in the editor, long before
        deployment.</p>

        <p>Zero configuration: open a project that contains the Flowable models you exported from Design
        (the app <code>.zip</code> / deployment <code>-bar</code>, holding
        <code>.bpmn / .cmmn / .dmn / .form / .data / .service / …</code>) or the Flowable Design
        <code>*-models</code> workspace, and start typing. The plugin indexes every model and puts that
        knowledge to work across three areas.</p>

        <h3>1 &middot; Model-key intelligence</h3>
        <ul>
          <li><b>Context-aware key completion</b> at every Flowable API position that takes a model key —
              process, case, decision, form, event, channel, data object, master data, service, action,
              agent, knowledge base, template, security policy, query, variable extractor, sequence, SLA,
              dashboard component, data dictionary, page and unified work definitions. Both
              <code>org.flowable.*</code> and <code>com.flowable.*</code>. Search by <b>key, by name, or by
              any fragment</b> — type <code>0061</code> to get <code>DEMO-DO-0061</code>.</li>
          <li><b>Cascade completion</b> for fluent chains — <code>operation("…")</code> completes the
              operations of the data object / service resolved from the sibling
              <code>definitionKey(…)</code> / <code>serviceKey(…)</code> (constant references are
              resolved), and <code>value("…", …)</code> completes that operation's input fields. DMN
              <code>variable("…", …)</code> offers the decision's input/output variables.</li>
          <li><b>More than keys</b> — completion for message &amp; signal names, process variables,
              task-definition keys and activity IDs, <b>scoped</b> to the
              <code>processDefinitionKey</code> / <code>caseDefinitionKey</code> in the same query chain
              when present, so you see only that model's ids.</li>
          <li><b>Model &rarr; model references in BPMN/CMMN XML</b> — the keys that live inside the models
              themselves (<code>callActivity calledElement</code>, <code>flowable:formKey</code>,
              <code>decisionRef</code>, CMMN <code>caseRef</code> / <code>processRef</code>) get the same
              completion, Ctrl/Cmd-click navigation and broken-key inspection as Java call sites — so a
              <code>calledElement</code> pointing at a missing process is caught before deployment.</li>
          <li><b>Broken-key inspection</b> — an unknown key (in Java or model XML) is flagged inline with a
              <i>"did you mean …?"</i> quick-fix to the closest real key.</li>
          <li><b>Navigation &amp; Find Usages</b> — Ctrl/Cmd-click a key literal to jump straight to the
              model file; hover for its type, name and location. Find Usages on a delegate class or an
              <code>${bean.method()}</code> expression lists the model files that reference it.</li>
          <li><b>Code generation</b> — generate a typed Java constants class
              (<code>FlowableModelKeys.Process.ORDER_FULFILMENT</code>, model name in Javadoc) that stays
              in sync as models are added, renamed or removed; or, with Alt/Option-Enter on a data-object
              <code>definitionKey("…")</code>, a typed Java bean built from the model's field mappings.</li>
          <li><b>Liquibase aware</b> — inside a changelog it completes <code>&lt;column&gt;</code> names
              and <code>tableName</code> from the backing service model, and flags columns that no
              backing Flowable model defines.</li>
        </ul>

        <h3>2 &middot; Flowable expression language support</h3>
        <ul>
          <li><b>Both dialects, first-class</b> — the backend JUEL dialect (<code>${…}</code> /
              <code>#{…}</code>) and the frontend form dialect (<code>{{…}}</code>) each get syntax
              highlighting, rainbow parentheses and brace matching.</li>
          <li><b>Live validation</b> — structural syntax errors, and unknown functions, namespaces or
              <code>flw.*</code> members, are flagged against a catalog of the real, verified Flowable
              function set.</li>
          <li><b>Expression completion</b> — functions, engine root objects, and your project's own
              process/case variables and form fields.</li>
          <li><b>Recognised inline, everywhere expressions live</b> — BPMN/CMMN/DMN XML,
              <code>.form</code> / <code>.page</code> JSON, and (optionally) Java string literals — so the
              highlighting, validation and completion follow you into the models you edit.</li>
          <li><b>Real Groovy &amp; JavaScript in script bodies</b> — BPMN/CMMN script tasks, listener
              scripts and action-bot scripts get the IDE's own language support injected inline:
              compiler-grade syntax errors, highlighting and fragment editing (Alt-Enter). Groovy is
              bundled in every IDEA; JavaScript lights up on Ultimate. JUEL or unknown script formats
              keep the plain expression injection. Atlas additionally runs its own dependency-free
              structural script check (unterminated strings/comments, unbalanced brackets,
              <code>scriptFormat</code> typos) in the CLI and the explorer's Checks tab.</li>
          <li><b>Flowable environments</b> — define your DEV/QA/UAT/PROD servers once for the whole IDE
              instead of once per repository, and pick them from a list. Each environment holds a Flowable
              Design connection, a Flowable Work connection, or just one of the two; the Design pull and the
              Expression Playground point independently, so running against QA while models still come from
              DEV1 is an ordinary way to work. Mark an environment <i>Protected</i> and Atlas asks before
              pulling from it or evaluating against it. Passwords and tokens stay in the IDE password
              safe.</li>
          <li><b>Expression Playground</b> (the <i>Flowable Expressions</i> tool window) — type an
              expression, pick backend or frontend, and get instant validation and completion; scope
              completion to one model; evaluate a frontend expression live against a pasted JSON payload;
              or evaluate a backend expression against a running app through the Flowable Inspect REST API.
              Which app it runs against is one of your <b>environments</b>, and the fastest way to switch is
              to paste a Work URL: the environment, the scope and the instance id all fill in from the
              link.</li>
          <li><b>Script Playground</b> (the <i>Scripts</i> tab of the same tool window) — paste or
              write a Groovy/JavaScript/Python script: the IDE's real language editing (completion,
              coloring) where the language plugin is available, live structural validation with
              squiggles and clickable problem rows (the same checks the CLI and the explorer's Checks
              tab run), the scope variables the script touches as chips, a picker that loads any
              script task / listener / action-bot script straight from the project's models, and a
              library of worked examples — a complete, commented script for every context and
              language, to start from rather than from an empty editor.</li>
        </ul>

        <h3>3 &middot; Atlas explorer &amp; hub</h3>
        <ul>
          <li><b>Atlas Hub</b> — a tool window (right stripe) that is the plugin's control center:
              which Flowable project Atlas is about, how many models it knows and how fresh that is, one
              attention line when something needs a hand, and three task blocks — the generated explorer,
              the Flowable Design pull, the playground's runtime — each with its actions beside its state,
              kept up to date live.</li>
          <li><b>Map your whole project</b> — Tools → Flowable Atlas → <i>Generate Atlas Explorer…</i>
              turns your models + Java + Liquibase into a single self-contained, offline, interactive
              HTML page. Save it into the project and open it in your browser or right inside the IDE
              (embedded viewer), then click through every relationship in both directions. In
              Settings → Generation you pick exactly which artifacts are written — summary &amp;
              overview Markdown, the graph JSON, the explorer HTML, a CLAUDE.md primer for AI agents.
              Generation runs entirely in-process — no external tools required — and honours the
              project's expression allowlist.</li>
          <li><b>IDE-native viewing</b> — the embedded explorer follows the IDE light/dark theme
              (switching restyles live) and carries a toolbar with <i>Regenerate Atlas Explorer</i>,
              <i>Reload</i>, <i>Open Expression Playground</i> and <i>Open in Browser</i>.</li>
          <li><b>Reopen without regenerating</b> — <i>Open Atlas Explorer</i> (Atlas Hub, or Tools →
              Flowable Atlas) opens an already-generated <code>*.explorer.html</code> — including
              one written by the standalone <code>atlas</code> CLI into the configured output folder — as a
              center editor tab (like a DB table), so you never have to leave the IDE for a browser.</li>
        </ul>

        <h3>How it feels</h3>
        <ul>
          <li><code>runtimeService.startProcessInstanceByKey("&lt;caret&gt;")</code> → your process keys.</li>
          <li><code>cmmnRuntimeService.createCaseInstanceBuilder().caseDefinitionKey("&lt;caret&gt;")</code> → your case keys.</li>
          <li><code>dataObjectRuntimeService.createDataObjectInstanceQuery().definitionKey(KEY).operation("&lt;caret&gt;")</code>
              → that data object's operations; <code>.value("&lt;caret&gt;", …)</code> → the operation's fields.</li>
          <li>Press completion twice to list <b>all</b> model keys of every type, regardless of the call site.</li>
        </ul>

        <p>Completion fires inside string literals and at bare arguments alike (inserting a quoted key),
        with Flowable keys ranked to the top — no setup beyond opening a project that contains your
        Flowable models.</p>
    ]]></description>

    <change-notes><![CDATA[
        <p>Older releases: see <code>CHANGELOG.md</code> in the repository.</p>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <!-- XML PSI for the Liquibase-changelog coverage inspection. -->
    <depends>com.intellij.modules.xml</depends>
    <!-- JSON PSI for form-model {{…}} expression injection and the .form → JSON association. -->
    <depends>com.intellij.modules.json</depends>
    <!-- JCEF (Atlas Hub, the explorer editor, the Inspect sign-in browser). Up to 2026.1 JCEF sat in the
         platform core; 2026.2 (build 262, the floor since the 2026.2 move) has it in the bundled
         "Web Browser (JCEF)" plugin (id com.intellij.modules.jcef), which is also why :idea-plugin has to
         put that plugin on its compile classpath. Still declared *optional*: someone who disables the
         bundled plugin, or an IDE without JCEF at all (remote dev), should lose the browser panels rather
         than the whole plugin — every call site is guarded by JBCefApp.isSupported() for exactly that. -->
    <depends optional="true" config-file="flowable-atlas-jcef.xml">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.FlowableAtlasBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Services (FlowableModelIndexService, ModelConstantsService/Settings) are @Service — no registration needed. -->
        <!-- Settings tree: an app-level root page (core toggles) with project-level children.
             parentId chaining across levels is supported — the settings tree merges them by ID. -->
        <applicationConfigurable
                parentId="tools"
                id="com.flowable.atlas.settings"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas"
                instance="com.flowable.atlas.settings.FlowableAtlasConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings"
                id="com.flowable.atlas.settings.expressions"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.expressions"
                instance="com.flowable.atlas.settings.ExpressionsConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings"
                id="com.flowable.atlas.settings.generation"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.generation"
                instance="com.flowable.atlas.settings.GenerationConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings.generation"
                id="com.flowable.atlas.settings.generation.constants"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.generation.constants"
                instance="com.flowable.atlas.settings.GenerationConstantsConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings.generation"
                id="com.flowable.atlas.settings.generation.liquibase"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.generation.liquibase"
                instance="com.flowable.atlas.settings.GenerationLiquibaseConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings.generation"
                id="com.flowable.atlas.settings.generation.dto"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.generation.dto"
                instance="com.flowable.atlas.settings.GenerationDtoConfigurable"/>
        <projectConfigurable
                parentId="com.flowable.atlas.settings"
                id="com.flowable.atlas.settings.environments"
                bundle="messages.FlowableAtlasBundle"
                key="configurable.atlas.environments"
                instance="com.flowable.atlas.settings.EnvironmentsConfigurable"/>
        <completion.contributor
                language="JAVA"
                implementationClass="com.flowable.atlas.completion.FlowableJavaCompletionContributor"/>
        <!-- Liquibase changelog: complete <column name="…"> / tableName from the backing service model. -->
        <completion.contributor
                language="XML"
                implementationClass="com.flowable.atlas.liquibase.LiquibaseColumnCompletionContributor"/>
        <!-- BPMN/CMMN model XML: complete model keys at cross-reference attributes
             (calledElement, flowable:formKey, decisionRef, caseRef, processRef, …). -->
        <completion.contributor
                language="XML"
                implementationClass="com.flowable.atlas.completion.FlowableXmlKeyCompletionContributor"/>
        <localInspection
                language="JAVA"
                shortName="FlowableValueField"
                displayName="Invalid Flowable data-object value field"
                groupName="Flowable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.flowable.atlas.inspection.FlowableValueFieldInspection"/>
        <localInspection
                language="JAVA"
                shortName="FlowableBrokenKey"
                displayName="Unknown Flowable model key"
                groupName="Flowable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.flowable.atlas.inspection.FlowableBrokenKeyInspection"/>
        <!-- BPMN/CMMN model XML: an unknown model key at a cross-reference attribute (broken deployment). -->
        <localInspection
                language="XML"
                shortName="FlowableXmlBrokenKey"
                displayName="Unknown Flowable model key (model XML)"
                groupName="Flowable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.flowable.atlas.inspection.FlowableXmlBrokenKeyInspection"/>
        <!-- Ctrl-click a key literal → jump to the model file; Find Usages works too. -->
        <psi.referenceContributor
                language="JAVA"
                implementation="com.flowable.atlas.navigation.FlowableKeyReferenceContributor"/>
        <!-- Ctrl-click a model key in BPMN/CMMN XML (calledElement, formKey, decisionRef, …) → the model file. -->
        <psi.referenceContributor
                language="XML"
                implementation="com.flowable.atlas.navigation.FlowableXmlKeyReferenceContributor"/>
        <!-- Hover / Ctrl-Q on a key literal → model type, name and file. -->
        <lang.documentationProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.navigation.FlowableKeyDocumentationProvider"/>
        <!-- Search Everywhere / Go to Symbol: every model key (→ model file) and every bot key
             (→ the BotService class and the actions that invoke it). -->
        <gotoSymbolContributor
                implementation="com.flowable.atlas.navigation.FlowableKeyGotoSymbolContributor"/>
        <!-- A "Flowable Model" tab of its own in Search Everywhere: model keys and the file paths
             inside a .bar/.zip (invisible to the Files tab), plus a live full-text search over model
             content (invisible to Find in Files). The contributor above stays — it feeds the
             platform's Symbols tab, this feeds its own. -->
        <searchEverywhereContributor
                implementation="com.flowable.atlas.navigation.se.FlowableModelSeContributor$Factory"/>
        <!-- Liquibase changelog column not mapped in the backing Flowable service/data-object model. -->
        <localInspection
                language="XML"
                shortName="FlowableLiquibaseCoverage"
                displayName="Liquibase column not defined in Flowable model"
                groupName="Flowable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.flowable.atlas.liquibase.LiquibaseCoverageInspection"/>
        <!-- Alt-Enter on a data-object definitionKey → generate a typed Java bean from its fields. -->
        <intentionAction>
            <language>JAVA</language>
            <className>com.flowable.atlas.intention.GenerateDataObjectBeanIntention</className>
            <category>Flowable</category>
        </intentionAction>
        <!-- Alt-Enter on a model key in Java → the model's page in the Atlas Explorer (the reverse of the
             page's "open in IDE" button). -->
        <intentionAction>
            <language>JAVA</language>
            <className>com.flowable.atlas.intention.OpenInAtlasExplorerIntention</className>
            <category>Flowable</category>
        </intentionAction>
        <!-- Find Usages on a model's key, in its own file → every model and every Java call site that names it. -->
        <findUsagesHandlerFactory implementation="com.flowable.atlas.usage.ModelKeyFindUsagesHandlerFactory"/>
        <!-- Don't report Java referenced from models (delegates, ${bean.method()}, listeners) as unused. -->
        <implicitUsageProvider implementation="com.flowable.atlas.usage.FlowableImplicitUsageProvider"/>
        <!-- Find Usages / Ctrl-B on a delegate class or ${bean.method()} shows the model files that use it. -->
        <customUsageSearcher implementation="com.flowable.atlas.usage.FlowableModelUsageSearcher"/>
        <!-- Gutter icon on Java methods/beans referenced from Flowable models → navigate to the model usages. -->
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.usage.FlowableModelReferenceLineMarkerProvider"/>
        <!-- Gutter icon on a BotService class → navigate to the .action models that invoke the bot. -->
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.usage.FlowableBotActionLineMarkerProvider"/>
        <!-- Gutter icon on a @GetMapping/@PostMapping/… handler → navigate to the models calling its endpoint. -->
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.usage.FlowableEndpointUsageLineMarkerProvider"/>
        <!-- Gutter icon on a model-key expression — a literal or a constant/local reference at a key
             call site — whose model has a diagram (bundled Design .svg, or rendered from its DI layout)
             → open it in the IDE's built-in image/SVG viewer. No diagram (e.g. a form BAR) → no marker. -->
        <codeInsight.lineMarkerProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.usage.FlowableDiagramLineMarkerProvider"/>
        <!-- Inline hint: the physical table name after a string literal that is a data-object key. -->
        <codeInsight.declarativeInlayProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.hint.FlowableDataObjectTableInlayProvider"
                isEnabledByDefault="true"
                group="VALUES_GROUP"
                providerId="com.flowable.atlas.dataObjectTable"
                bundle="messages.FlowableAtlasBundle"
                nameKey="inlay.dataObjectTable.name"
                descriptionKey="inlay.dataObjectTable.description"/>
        <!-- Inline hint: the action model's name after a string literal that is an .action key. -->
        <codeInsight.declarativeInlayProvider
                language="JAVA"
                implementationClass="com.flowable.atlas.hint.FlowableActionNameInlayProvider"
                isEnabledByDefault="true"
                group="VALUES_GROUP"
                providerId="com.flowable.atlas.actionName"
                bundle="messages.FlowableAtlasBundle"
                nameKey="inlay.actionName.name"
                descriptionKey="inlay.actionName.description"/>
        <!-- Warn when renaming a Java symbol referenced by Flowable model expressions (text, not auto-updated). -->
        <refactoring.elementListenerProvider
                implementation="com.flowable.atlas.usage.FlowableRenameWarningProvider"/>
        <!-- Balloon shown after generating the Atlas explorer (open in browser / open in IDE). -->
        <notificationGroup id="Flowable Atlas" displayType="BALLOON"/>
        <!-- The embedded "Atlas Explorer" editor tab is registered in flowable-atlas-jcef.xml: it needs
             the bundled JCEF plugin, and a provider named here would be asked on every file open
             whether or not that plugin is loaded. -->
        <!-- "Models changed since this explorer was generated" banner above the page. -->
        <editorNotificationProvider implementation="com.flowable.atlas.explorer.AtlasExplorerStaleNotificationProvider"/>

        <!-- ==================== Flowable Expression support ==================== -->
        <!-- Two dialects of one expression language: backend ${…}/#{…} (JUEL) and frontend {{…}} (flw.*). -->
        <fileType name="Flowable Backend Expression"
                  language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableBackendExprFileType"
                  fieldName="INSTANCE"
                  extensions="flowable-be"/>
        <fileType name="Flowable Frontend Expression"
                  language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableFrontendExprFileType"
                  fieldName="INSTANCE"
                  extensions="flowable-fe"/>
        <lang.parserDefinition language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableBackendExprParserDefinition"/>
        <lang.parserDefinition language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableFrontendExprParserDefinition"/>
        <!-- Token coloring (parentheses, brackets, strings, operators, …) for both dialects. -->
        <lang.syntaxHighlighterFactory language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableExprSyntaxHighlighterFactory"/>
        <lang.syntaxHighlighterFactory language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableExprSyntaxHighlighterFactory"/>
        <!-- Match () and [] — caret on a brace highlights its partner, unmatched braces are flagged. -->
        <lang.braceMatcher language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableExprBraceMatcher"/>
        <lang.braceMatcher language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.lang.FlowableExprBraceMatcher"/>
        <!-- Structural syntax squiggles for both dialects (playground + injected fragments). -->
        <annotator language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.annotator.FlowableExpressionAnnotator"/>
        <annotator language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.annotator.FlowableExpressionAnnotator"/>
        <!-- Semantic expression findings as real inspections: severity/enablement per profile, project
             allowlist via quick fix. No language attribute — the two dialects share no registered base
             language; the implementations bail out immediately on any non-expression file. -->
        <localInspection
                shortName="FlowableExprUnknownFunction"
                displayName="Unknown Flowable expression function or namespace"
                groupName="Flowable"
                enabledByDefault="true"
                level="WARNING"
                implementationClass="com.flowable.atlas.expr.inspection.FlowableExprUnknownFunctionInspection"/>
        <localInspection
                shortName="FlowableExprGrounding"
                displayName="Expression root is not a known variable, bean, or root object"
                groupName="Flowable"
                enabledByDefault="false"
                level="WEAK WARNING"
                implementationClass="com.flowable.atlas.expr.inspection.FlowableExprGroundingInspection"/>
        <!-- Rainbow parentheses are done in the syntax highlighter (FlowableExprSyntaxHighlighter):
             the highlighting lexer tags each round paren with its nesting level and each level gets
             a distinct colour. This paints in every surface, including the playground's embedded
             editor field where an annotator would not. Per-theme default colours + the Color Scheme
             page that makes them customizable: -->
        <additionalTextAttributes scheme="Default" file="colorSchemes/FlowableExprDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/FlowableExprDarcula.xml"/>
        <colorSettingsPage implementation="com.flowable.atlas.expr.lang.FlowableExprColorSettingsPage"/>
        <!-- Alt-Enter on an injected ${…}/{{…}} fragment → rework it in the playground, pre-filled.
             Registered once (no <language> filter): the same class must not be registered twice or the
             platform rejects it as a duplicate. isAvailable() self-gates on FlowableExprFile, which
             covers both the backend and frontend dialects. -->
        <intentionAction>
            <className>com.flowable.atlas.expr.intention.OpenInExpressionPlaygroundIntention</className>
            <category>Flowable</category>
        </intentionAction>
        <!-- Ctrl-Q / hover on a catalog function or root inside an expression → call head + doc line. -->
        <lang.documentationProvider language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.documentation.FlowableExprDocumentationProvider"/>
        <lang.documentationProvider language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.documentation.FlowableExprDocumentationProvider"/>
        <!-- Completion of functions, root objects and the project's variables/form-fields. -->
        <completion.contributor language="FlowableBackendExpr"
                  implementationClass="com.flowable.atlas.expr.completion.FlowableExpressionCompletionContributor"/>
        <completion.contributor language="FlowableFrontendExpr"
                  implementationClass="com.flowable.atlas.expr.completion.FlowableExpressionCompletionContributor"/>
        <!-- Inject the expression languages inline wherever expressions live in the repo. -->
        <multiHostInjector implementation="com.flowable.atlas.expr.inject.FlowableXmlExpressionInjector"/>
        <multiHostInjector implementation="com.flowable.atlas.expr.inject.FlowableJsonExpressionInjector"/>
        <multiHostInjector implementation="com.flowable.atlas.expr.inject.FlowableJavaExpressionInjector"/>
        <!-- Inject the IDE's real Groovy / JavaScript languages into Flowable script bodies (BPMN
             scriptTask, CMMN script tasks, execution/task listener scripts, action-bot scriptInfo):
             compiler-grade syntax errors right in the model file. Languages are resolved by ID at
             runtime (Language.findLanguageByID), so there is NO hard or optional plugin dependency —
             no Groovy/JavaScript plugin simply means no injection, never an error. -->
        <multiHostInjector implementation="com.flowable.atlas.script.inject.FlowableXmlScriptInjector"/>
        <multiHostInjector implementation="com.flowable.atlas.script.inject.FlowableJsonScriptInjector"/>
        <!-- Completion for the Flowable script bindings (execution.…, task.…, flw.time.…): the real
             language completion knows nothing about these dynamic bindings, so the bindings catalog
             offers them — in the Script Playground and inside injected script bodies. language="any"
             because the host language varies (Groovy/JS/plain-text fallback) and this plugin has no
             dependency on the language plugins; the contributor gates itself cheaply. -->
        <completion.contributor language="any"
                  implementationClass="com.flowable.atlas.script.completion.ScriptBindingsCompletionContributor"/>
        <!-- Silence the Groovy/JS "unresolved" noise on the engine bindings (execution, flw, …)
             inside Flowable script bodies — they are dynamic bindings the language PSI can never
             resolve. Scoped to the playground + injected script fragments; real syntax errors and
             the bindings-catalog validation are unaffected. Registered per language (the suppressor
             lookup does not honor "any"); an entry for an absent language plugin is simply dormant,
             so this keeps the no-Groovy/JS-dependency rule intact. -->
        <lang.inspectionSuppressor language="Groovy"
                  implementationClass="com.flowable.atlas.script.inspection.FlowableScriptInspectionSuppressor"/>
        <lang.inspectionSuppressor language="JavaScript"
                  implementationClass="com.flowable.atlas.script.inspection.FlowableScriptInspectionSuppressor"/>
        <!-- Hover / Ctrl-Q on a binding shows catalog documentation instead of the platform's
             "No candidates found for method call" fallback for unresolvable dynamic bindings. -->
        <lang.documentationProvider language="Groovy"
                  implementationClass="com.flowable.atlas.script.documentation.ScriptBindingsDocumentationProvider"/>
        <lang.documentationProvider language="JavaScript"
                  implementationClass="com.flowable.atlas.script.documentation.ScriptBindingsDocumentationProvider"/>
        <lang.documentationProvider language="TEXT"
                  implementationClass="com.flowable.atlas.script.documentation.ScriptBindingsDocumentationProvider"/>
        <!-- The Script Playground's scratch file resolves imports against the whole project —
             without a module, `import org.slf4j.LoggerFactory` would never resolve there. -->
        <resolveScopeProvider implementation="com.flowable.atlas.script.toolwindow.ScriptPlaygroundResolveScopeProvider"/>
        <!-- Treat Flowable form models (.form) as JSON so their {{…}} strings become injection hosts,
             and action models (.action) so their scriptInfo.script strings can host Groovy/JS. The
             remaining JSON-serialized model extensions are here so a model OPENS with its content:
             an unregistered extension resolves to UnknownFileType, which is binary, so the editor
             shows the "file type not associated" panel instead — most visibly for an entry opened
             out of a .bar/.zip. A <fileType> with no implementationClass only adds matchers to the
             existing type (the same idiom the bundled javaFX and Maven plugins use). The list mirrors
             ModelType.EXTENSIONS in :core. -->
        <fileType name="JSON"
                  extensions="form;action;page;data;dictionary;query;sequence;sla;event;channel;agent;service;tpl;policy;extractor;knowledgebase;masterdata;dashboardcomponent;document;palette;app"/>
        <!-- The XML-serialized models. .bpmn20.xml / .cmmn.xml / .dmn.xml already end in .xml. -->
        <fileType name="XML" extensions="bpmn;cmmn;dmn"/>
        <!-- A model file wears its type's icon — the explorer's glyph and colour — in the Project view
             and the editor tabs; a .bar the archive icon. Decided from the name alone. -->
        <fileIconProvider implementation="com.flowable.atlas.icons.ModelFileIconProvider"/>
        <!-- Reader Mode's visual formatting layer crashes on minified single-line JSON, which is what a
             Design model export is; order="last" is load-bearing, because the platform enables the layer
             from this same extension point. See FlowableModelVisualFormattingGuard. -->
        <readerModeProvider implementation="com.flowable.atlas.model.FlowableModelVisualFormattingGuard"
                            order="last"/>
        <!-- The Expression Playground: type an expression, get validation + completion. -->
        <toolWindow id="Flowable Expressions"
                    anchor="bottom"
                    secondary="true"
                    icon="/icons/atlas/playground.svg"
                    factoryClass="com.flowable.atlas.expr.toolwindow.FlowableExpressionToolWindowFactory"/>
        <!-- The Atlas Hub: the plugin's control center (model-index status, generated explorers,
             Flowable Design sync). Right anchor — the home of project control-center panels
             (Gradle, Maven, Database). -->
        <toolWindow id="Atlas Hub"
                    anchor="right"
                    icon="/icons/atlas/hub.svg"
                    factoryClass="com.flowable.atlas.hub.AtlasHubToolWindowFactory"/>
        <!-- "Report Flowable Atlas Problem…" in the IDE's error dialog: builds the report, copies it to
             the clipboard and opens the issue tracker — nothing is transmitted by the plugin itself. -->
        <errorHandler implementation="com.flowable.atlas.AtlasErrorReportSubmitter"/>
        <!-- Starts the model-index build when a project opens, so the Hub, the markers and the
             inspections do not wait for the first completion or Rebuild click to ask for one. -->
        <postStartupActivity implementation="com.flowable.atlas.index.FlowableIndexWarmUp"/>
    </extensions>

    <projectListeners>
        <!-- Regenerates the model-constants class when models are added/removed/edited. -->
        <listener class="com.flowable.atlas.generate.ModelConstantsAutoRefresher"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <!-- Action/group texts and descriptions come from messages/FlowableAtlasBundle.properties
         (action.<id>.text / .description keys). Ellipsis convention: only actions that always need
         further input before they can complete carry one. -->
    <actions resource-bundle="messages.FlowableAtlasBundle">
        <group id="Flowable.Menu" popup="true" icon="/icons/atlas/model.svg">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <!-- Open -->
            <action id="Flowable.OpenAtlasHub"
                    class="com.flowable.atlas.action.OpenAtlasHubAction"
                    icon="/icons/atlas/hub.svg"/>
            <!-- Icons: AtlasIcons (/icons/atlas) where the thing has a meaning of its own, platform icons
                 for platform verbs (search, download). No entry in the main toolbar — the hub is the
                 plugin's visible surface, everything else stays in the menu. -->
            <action id="Flowable.OpenAtlasExplorer"
                    class="com.flowable.atlas.action.OpenAtlasExplorerAction"
                    icon="/icons/atlas/explorer.svg"/>
            <action id="Flowable.OpenExpressionPlayground"
                    class="com.flowable.atlas.action.OpenExpressionPlaygroundAction"
                    icon="/icons/atlas/playground.svg"/>
            <!-- Opens Search Everywhere on the "Flowable Model" tab — otherwise reachable only by
                 pressing Shift twice and tabbing across to it, which nobody discovers unaided. -->
            <action id="Flowable.SearchModels"
                    class="com.flowable.atlas.action.SearchFlowableModelsAction"
                    icon="AllIcons.Actions.Search">
                <!-- The one action that competes with Shift-Shift for the hand: worth a chord. -->
                <keyboard-shortcut keymap="$default" first-keystroke="control alt shift M"/>
            </action>
            <separator/>

            <!-- Generate (submenu, with a nested Liquibase submenu) -->
            <group id="Flowable.Generate" popup="true">
                <action id="Flowable.GenerateAtlasExplorer"
                        class="com.flowable.atlas.action.GenerateAtlasExplorerAction"
                        icon="/icons/atlas/explorer.svg"/>
                <!-- No ellipsis: it re-runs the existing page(s) with the settings as they are. Its text is
                     what the Hub, the explorer banner and the post-pull balloon show (FlowableActionIds.text). -->
                <action id="Flowable.RegenerateAtlasExplorer"
                        class="com.flowable.atlas.action.RegenerateAtlasExplorerAction"/>
                <action id="Flowable.GenerateModelConstants"
                        class="com.flowable.atlas.action.GenerateModelConstantsAction"/>
                <group id="Flowable.GenerateLiquibase" popup="true">
                    <action id="Flowable.GenerateLiquibaseFromDataObject"
                            class="com.flowable.atlas.action.GenerateLiquibaseFromDataObjectAction"/>
                    <action id="Flowable.GenerateLiquibaseFromApps"
                            class="com.flowable.atlas.action.GenerateLiquibaseFromAppsAction"/>
                </group>
                <group id="Flowable.GenerateDto" popup="true">
                    <action id="Flowable.GenerateDtoFromDataObject"
                            class="com.flowable.atlas.action.GenerateDtoFromDataObjectAction"/>
                    <action id="Flowable.GenerateDtoFromApps"
                            class="com.flowable.atlas.action.GenerateDtoFromAppsAction"/>
                </group>
            </group>
            <separator/>

            <!-- Flowable Design -->
            <action id="Flowable.SwitchDesignEnvironment"
                    class="com.flowable.atlas.action.SwitchDesignEnvironmentAction"/>
            <action id="Flowable.PullFromDesign"
                    class="com.flowable.atlas.action.PullFromDesignAction"
                    icon="AllIcons.Actions.Download"/>
            <action id="Flowable.SwitchWorkEnvironment"
                    class="com.flowable.atlas.action.SwitchWorkEnvironmentAction"/>
            <action id="Flowable.ManageEnvironments"
                    class="com.flowable.atlas.action.ManageEnvironmentsAction"/>
            <separator/>

            <!-- Maintenance -->
            <action id="Flowable.RebuildModelIndex"
                    class="com.flowable.atlas.action.RebuildModelIndexAction"/>
            <!-- Debug helper; visible only with idea.is.internal=true. -->
            <action id="Flowable.DumpKeyIndex" internal="true"
                    class="com.flowable.atlas.action.DumpFlowableIndexAction"/>
        </group>

        <!-- Right-click on a folder, a model file or an archive in the Project view: the two actions
             that are about the thing under the cursor. Hidden elsewhere (FlowableProjectViewGroup). -->
        <group id="Flowable.ProjectViewPopup" class="com.flowable.atlas.action.FlowableProjectViewGroup" popup="false">
            <separator/>
            <reference ref="Flowable.GenerateAtlasExplorer"/>
            <reference ref="Flowable.SearchModels"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </group>
    </actions>
</idea-plugin>
