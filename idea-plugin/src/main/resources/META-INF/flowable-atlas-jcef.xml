<!-- Optional-dependency descriptor for the bundled JCEF plugin (2026.2+, see plugin.xml). The platform
     loads it only when that plugin is enabled, so what it registers can name com.intellij.ui.jcef.*
     freely; the main descriptor must not, because a provider asked on every file open links its class
     with or without JCEF — a NoClassDefFoundError in the IDE with the browser plugin disabled, not a
     graceful "no explorer tab". Everything else JCEF-related stays in plugin.xml behind
     JcefSupport.isAvailable(), which catches the missing link. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <!-- Render a *.explorer.html as an embedded (JCEF) "Atlas Explorer" tab in the center editor
             area (like a DB table); hides the raw-HTML "Text" tab for it. -->
        <fileEditorProvider implementation="com.flowable.atlas.explorer.AtlasFileEditorProvider"/>
    </extensions>
</idea-plugin>
