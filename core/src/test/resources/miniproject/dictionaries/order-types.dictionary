{
  "key": "orderTypes",
  "name": "Order types",
  "description": "Shared structured types for the order models",
  "types": [
    {
      "name": "Address",
      "properties": [
        {"name": "street", "type": "string"},
        {"name": "city", "type": "string"},
        {"name": "countryCode", "type": "string"}
      ]
    },
    {
      "name": "Customer",
      "properties": [
        {"name": "customerName", "type": "string"},
        {"name": "billingAddress", "type": "Address"}
      ]
    }
  ]
}
