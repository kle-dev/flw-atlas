{
  "metadata": {"key": "orderForm", "name": "Order Form", "modelType": "form"},
  "rows": [
    [
      {
        "id": "customer",
        "type": "select",
        "label": "Customer",
        "extraSettings": {"queryUrl": "/api/customers"}
      }
    ],
    [
      {"id": "amount", "type": "number", "label": "Amount", "isRequired": true}
    ],
    [
      {"id": "totalDisplay", "type": "text", "label": "Total", "value": "{{amount}}"}
    ],
    [
      {
        "id": "lookupCustomer",
        "type": "button",
        "label": "Lookup customer",
        "extraSettings": {"serviceModel": {"serviceModelKey": "customerService", "operationKey": "findAll"}}
      }
    ],
    [
      {
        "id": "customerRecord",
        "type": "select",
        "label": "Customer record",
        "extraSettings": {"dataObjectDefinitionKey": "customerDO", "dataObjectOperationKey": "findAll"}
      }
    ],
    [
      {
        "id": "canEditButton",
        "type": "restButton",
        "extraSettings": {
          "text": "Check if editable",
          "url": "{{endpoints.baseUrl}}/api/customers/{{customer}}/canEdit",
          "path": "data",
          "responsePayloadMapping": [
            {"name": "$temp.canEdit", "expression": "{{$response.canEdit}}"}
          ]
        }
      }
    ],
    [
      {
        "id": "notifyButton",
        "type": "workAction",
        "label": "Notify customer",
        "visible": "{{amount > 0}}",
        "primary": true,
        "extraSettings": {
          "actionDefinitionKey": "notifyCustomerAction",
          "sendPayloadMapping": [
            {"name": "customerEmail", "expression": "{{customer.email}}"},
            {"name": "orderTotal", "expression": "{{amount}}"}
          ],
          "responsePayloadMapping": [
            {"name": "$temp.sent", "expression": "{{$response.executionPayload.sent}}"}
          ]
        }
      }
    ],
    [
      {
        "id": "orderTotal",
        "type": "scriptButton",
        "value": "{{orderTotal}}",
        "extraSettings": {
          "text": "Recalculate",
          "script": "{{amount * 1.081}}",
          "autoExecute": true,
          "timer": 30000
        }
      }
    ],
    [
      {
        "id": "escalate",
        "type": "workAction",
        "extraSettings": {
          "actionDefinitionKey": {"key": "notifyCustomerAction", "id": "ACTION_MODEL-7"},
          "sendFullPayload": true,
          "mapFullResponse": true,
          "navigationUrl": "/work/case/{{$response.scopeId}}",
          "sendPayloadMapping": [
            {"name": "orderTotal", "expression": "{{orderTotal}}"}
          ]
        }
      }
    ],
    [
      {
        "id": "customerPortal",
        "type": "linkButton",
        "value": "Open customer portal",
        "extraSettings": {"url": "https://portal.example.com/{{customer}}", "target": "_blank"}
      }
    ],
    [
      {
        "id": "creditScore",
        "type": "restButton",
        "visible": false,
        "value": "{{$temp.score}}",
        "ignore": "{{!customer}}",
        "description": "Hidden worker: refreshes the score whenever the customer changes.",
        "i18n": {"en_us": {"extraSettings": {"text": "Refresh score"}}},
        "extraSettings": {
          "url": "/api/customers/{{customer}}/score",
          "valueExpression": "{{$response.score}}",
          "autoExecute": "{{customer}}",
          "executeAlways": true
        }
      }
    ],
    [
      {"id": "internalNote", "type": "textarea", "label": "Internal note", "enabled": "{{isSupervisor}}"}
    ]
  ],
  "outcomes": [
    {"value": "approve", "label": "Approve"}
  ]
}
