             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI">
  <process id="typeDemo" name="Type demo">
    <startEvent id="s1" name="Start"/>
    <userTask id="t1" name="Approve order"/>
    <serviceTask id="t2" name="Calculate" flowable:class="com.acme.X"/>
    <serviceTask id="t3" name="Lookup customer" flowable:type="service-registry">
      <extensionElements><design:stencilid><![CDATA[ServiceRegistryTask]]></design:stencilid></extensionElements>
    </serviceTask>
    <serviceTask id="t4" name="Ask the agent" flowable:type="agent"/>
    <serviceTask id="t5" name="Call REST" flowable:type="http"/>
    <serviceTask id="t6" name="Create region" flowable:type="data-object">
      <extensionElements><design:stencilid><![CDATA[DataObjectCreateTask]]></design:stencilid></extensionElements>
    </serviceTask>
    <scriptTask id="t7" name="Compute" scriptFormat="groovy"><script>x=1</script></scriptTask>
    <callActivity id="t8" name="Fulfil" calledElement="sub"/>
    <serviceTask id="t9" name="Send mail" flowable:type="mail"/>
    <userTask id="t10" name="Review each">
      <multiInstanceLoopCharacteristics isSequential="false"/>
    </userTask>
    <boundaryEvent id="b1" name="Timeout" attachedToRef="t1" cancelActivity="false">
      <timerEventDefinition><timeDuration>PT1H</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <exclusiveGateway id="g1" name="OK?"/>
    <endEvent id="e1" name="Failed"><errorEventDefinition errorRef="boom"/></endEvent>
  </process>
  <bpmndi:BPMNDiagram id="d"><bpmndi:BPMNPlane bpmnElement="typeDemo" id="p">
