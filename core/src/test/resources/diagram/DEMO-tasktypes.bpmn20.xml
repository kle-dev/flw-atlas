    <bpmndi:BPMNShape bpmnElement="t3" id="sh3"><omgdc:Bounds x="370" y="20" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t4" id="sh4"><omgdc:Bounds x="510" y="20" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t5" id="sh5"><omgdc:Bounds x="650" y="20" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t6" id="sh6"><omgdc:Bounds x="90" y="120" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t7" id="sh7"><omgdc:Bounds x="230" y="120" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t8" id="sh8"><omgdc:Bounds x="370" y="120" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t9" id="sh9"><omgdc:Bounds x="510" y="120" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="t10" id="sh10"><omgdc:Bounds x="650" y="120" width="110" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="b1" id="sh11"><omgdc:Bounds x="170" y="68" width="26" height="26"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="g1" id="sh12"><omgdc:Bounds x="90" y="220" width="40" height="40"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape bpmnElement="e1" id="sh13"><omgdc:Bounds x="180" y="225" width="30" height="30"/></bpmndi:BPMNShape>
